{
  "rewrites": [
    { "source": "/cirsma",            "destination": "/cirsma.html"   },
    { "source": "/krautuve",          "destination": "/krautuve.html" },
    { "source": "/caurmers",          "destination": "/caurmers.html" },
    { "source": "/api/anthropic/:path*", "destination": "/api/anthropic" },
    { "source": "/api/lvmgeo/:path*",   "destination": "/api/lvmgeo"   },
    { "source": "/(.*)",              "destination": "/index.html"    }
  ],
  "crons": [
    {
      "path": "/api/pavadzimes-cron",
      "schedule": "0 6 * * *"
    }
  ]
}
